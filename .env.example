# Server-side Supabase Auth project settings. Never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Use a separate sb_secret key and never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-secret-key
# HTTPS endpoint that delivers a lead to the listing seller or seller operations queue.
SELLER_NOTIFICATION_WEBHOOK_URL=https://notifications.example.com/gharbazaar/leads
SELLER_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-long-random-secret
