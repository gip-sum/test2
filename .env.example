# Server-side Supabase Auth project settings. Keep all credentials server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical origin for the Google OAuth callback; must be allowlisted in Supabase.
AUTH_SITE_URL=https://your-domain.example

# Server-only privileged key (legacy service_role or sb_secret_) for validated submissions.
# Set directly in deployment settings; never use NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# AI is disabled until a model, Gateway access and a finite Gateway budget are set.
AI_DESCRIPTION_ENABLED=false
AI_GATEWAY_MODEL=
# Optional outside Vercel; deployed workers prefer Vercel OIDC.
AI_GATEWAY_API_KEY=
